{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperweight",
  "version": "0.1.0",
  "identifier": "com.lokmanefe.paperweight",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/paperweight-engine"],
    "fileAssociations": [
      {"ext": ["pdf"], "name": "PDF document", "description": "PDF document", "role": "Viewer"}
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "See what makes a PDF heavy, then shrink it.",
    "licenseFile": "../LICENSE",
    "resources": ["../LICENSE", "../THIRD_PARTY.md"]
  }
}
